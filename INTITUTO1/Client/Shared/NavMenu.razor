@using INTITUTO1.Client.Auth
@using Microsoft.AspNetCore.Components.Authorization;
@inject AuthenticationStateProvider autenticacionProvider
@inject NavigationManager navManager

<div class="sidebar bg-dark vh-100" style="width: 250px; overflow-y: auto; position: fixed;">
    <div class="navbar-brand p-3 text-center">
        <a href="/Index">
            <img src="Logo_itsc.png" alt="Logo" style="width: 60px;" />
        </a>
    </div>

    <nav class="nav flex-column p-3">
        <NavLink class="nav-link text-light mb-2" href="/Index" Match="NavLinkMatch.All">
            <i class="bi bi-house-door"></i> Inicio
        </NavLink>

        <!-- Desplegable "Gestión de Carreras" -->
        <div class="dropdown">
            <div class="btn btn-dark text-light w-100 text-start mb-2">
                <i class="bi bi-briefcase"></i> Gestión de Carreras
            </div>
            <div class="dropdown-content">
                <NavLink class="nav-link text-light ms-3" href="Carrera">
                    <i class="bi bi-mortarboard"></i> Carreras
                </NavLink>
                <NavLink class="nav-link text-light ms-3" href="Division">
                    <i class="bi bi-diagram-3"></i> División
                </NavLink>
                <NavLink class="nav-link text-light ms-3" href="Materias">
                    <i class="bi bi-book"></i> Materias
                </NavLink>
                <NavLink class="nav-link text-light ms-3" href="Ciclo">
                    <i class="bi bi-calendar3"></i> Ciclos Lectivos
                </NavLink>
                <NavLink class="nav-link text-light ms-3" href="DivisionCiclo">
                    <i class="bi bi-clipboard-check"></i> División por Ciclo
                </NavLink>
            </div>
        </div>

        <!-- Desplegable "Gestión de Profesores" -->
        <div class="dropdown">
            <div class="btn btn-dark text-light w-100 text-start mb-2">
                <i class="bi bi-person-badge"></i> Gestión de Profesores
            </div>
            <div class="dropdown-content">
                <NavLink class="nav-link text-light ms-3" href="Profesores">
                    <i class="bi bi-person"></i> Profesores
                </NavLink>
                <NavLink class="nav-link text-light ms-3" href="AltaProfesor">
                    <i class="bi bi-person-plus"></i> Alta Docente
                </NavLink>
            </div>
        </div>

        <!-- Desplegable "Gestión de Alumnos" -->
        <div class="dropdown">
            <div class="btn btn-dark text-light w-100 text-start mb-2">
                <i class="bi bi-people"></i> Gestión de Alumnos
            </div>
            <div class="dropdown-content">
                <NavLink class="nav-link text-light ms-3" href="CargarDeExcel">
                    <i class="bi bi-upload"></i> Cargar alumnos desde Excel
                </NavLink>
                <NavLink class="nav-link text-light ms-3" href="Alumno">
                    <i class="bi bi-person-circle"></i> Registrar Alumnos
                </NavLink>
                <NavLink class="nav-link text-light ms-3" href="Inscripcion">
                    <i class="bi bi-pencil-square"></i> Inscribir Alumnos
                </NavLink>
            </div>
        </div>

        <!-- Desplegable "Gestión de Notas" -->
        <div class="dropdown">
            <div class="btn btn-dark text-light w-100 text-start mb-2">
                <i class="bi bi-journal-bookmark"></i> Gestión de Notas
            </div>
            <div class="dropdown-content">
                <NavLink class="nav-link text-light ms-3" href="Notas">
                    <i class="bi bi-card-list"></i> Calificaciones
                </NavLink>
                <NavLink class="nav-link text-light ms-3" href="Libros">
                    <i class="bi bi-journal"></i> Libro de Actas
                </NavLink>
                <NavLink class="nav-link text-light ms-3" href="TipoEvaluaciones">
                    <i class="bi bi-file-earmark-text"></i> Tipo De Evaluacion
                </NavLink>
            </div>
        </div>
        <div class="dropdown">
            <div class="btn btn-dark text-light w-100 text-start mb-2">
                <i class="bi bi-credit-card-2-front"></i> Formularios
            </div>
            <div class="dropdown-content">
                <NavLink class="nav-link text-light ms-3" href="formulario-certificado">
                    <i class="bi bi-book"></i> Certificado De Examen
                </NavLink>
                <NavLink class="nav-link text-light ms-3" href="ExcelNotas">
                    <i class="bi bi-book"></i> Reporte Notas
                </NavLink>
            </div>
        </div>
       

    </nav>
</div>

<style>
    .dropdown-content {
        display: none;
        flex-direction: column;
        padding-left: 15px;
    }

    /* Mostrar el contenido al pasar el mouse */
    .dropdown:hover .dropdown-content {
        display: flex;
    }
</style>



@code {
    private async Task CerrarSesion()
    {
        var autenticacionExt = (AutenticacionExtension)autenticacionProvider;
        await autenticacionExt.ActualizarEstadoAutenticacion(null);
        navManager.NavigateTo("/", true);
    }
}
<style>
    /* Animación para los botones del menú */
    .nav-link {
        transition: background-color 0.3s ease, transform 0.3s ease;
    }

        .nav-link:hover {
            background-color: #007bff; /* Cambia el color de fondo al pasar el ratón */
            transform: scale(1.05); /* Aumenta ligeramente el tamaño del botón */
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3); /* Añade una sombra */
        }
</style>



