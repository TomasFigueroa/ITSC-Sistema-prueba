@inject IJSRuntime JSRuntime
@page "/ReporteNotas"
@attribute [Authorize]
@using System.ComponentModel.DataAnnotations
@inject HttpClient Http

<h3>Formulario de Certificado de Examen</h3>

<InputText @bind-Value="certificado.NombreAdministrador" Placeholder="Nombre del Administrador" />
<InputText @bind-Value="certificado.NombreAlumno" Placeholder="Nombre del Alumno" />
<InputNumber @bind-Value="certificado.DniAlumno" Placeholder="DNI del Alumno" />
<InputText @bind-Value="certificado.Carrera" Placeholder="Carrera" />
<InputText @bind-Value="certificado.Interesado" Placeholder="Interesado" />
<InputNumber @bind-Value="certificado.DiaNumero" Placeholder="Día" />
<InputText @bind-Value="certificado.Mes" Placeholder="Mes" />
<InputNumber @bind-Value="certificado.Anio" Placeholder="Año" />

<button @onclick="ExportarExcel">Exportar a Excel</button>

@code {
    private CertificadoExamen certificado = new CertificadoExamen();

    private async Task ExportarExcel()
    {
        var response = await Http.PostAsJsonAsync("api/certificado/Template", certificado);
        if (response.IsSuccessStatusCode)
        {
            var stream = await response.Content.ReadAsStreamAsync();
            await JSRuntime.InvokeVoidAsync("downloadFileFromStream", "Certificado.xlsx", stream);
        }
        else
        {
            Console.WriteLine("No se pudo generar el archivo.");
        }
    }
}