    private async Task LoadDivisionCicloMaterias()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<List<DivisionCicloMateria>>("api/DivisionCicloMateria");

            //actualizacion de paginas
            TotalPages = (int)Math.Ceiling(response.Count / (double)PageSize);

            //obtener los ciclos de la página actual
            divisionCicloMaterias = response
                .Skip((CurrentPage - 1) * PageSize)
                .Take(PageSize)
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading DivisionCicloMaterias: {ex.Message}");
        }
    }

    private async Task ChangePage(int newPage)
    {
        if (newPage < 1 || newPage > TotalPages)
            return;

        CurrentPage = newPage;
        await LoadCiclos();
        StateHasChanged();
    }
 

