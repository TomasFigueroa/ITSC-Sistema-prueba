    private void OpenModalToAdd()
    {
        currentDivisionCicloMateria = new DTODivisionCicloMateria();
        isEdit = false;
        isModalOpen = true;
    }

    private void OpenModalToEdit(DivisionCicloMateria divisionCicloMateria, int id)
    {
        currentDivisionCicloMateria = new DTODivisionCicloMateria
            {
                DivisionCicloIdDivCic = divisionCicloMateria.DivisionCicloIdDivCic,
                MateriasIdMateria = divisionCicloMateria.MateriasIdMateria,
                ProfesorIdProfesor = divisionCicloMateria.ProfesorIdProfesor
            };
        idactual = id;
        isEdit = true;
        isModalOpen = true;
    }

    private void CloseModal()
    {
        isModalOpen = false;
    }

    private void OpenConfirmDeleteModal(int id)
    {
        idDivisionCicloMateriaToDelete = id;
        isConfirmDeleteModalOpen = true;
    }

    private void CloseConfirmDeleteModal()
    {
        isConfirmDeleteModalOpen = false;
    }

    private async Task AddDivisionCicloMateria()
    {
        try
        {
            var response = await Http.PostAsJsonAsync("api/DivisionCicloMateria", currentDivisionCicloMateria);
            if (response.IsSuccessStatusCode)
            {
                MostrarAlerta("¡División agregada con éxito!");
                await LoadDivisionCicloMaterias();
                CloseModal();
            }
            else
            {
                MostrarError("No se pudo agregar la división. Intenta nuevamente.");
            }
        }
        catch (Exception)
        {
            MostrarError("Error al agregar la división. Verifica los datos.");
        }
    }


    private async Task EditDivisionCicloMateria()
    {
        try
        {
            var response = await Http.PutAsJsonAsync($"api/DivisionCicloMateria/{idactual}", currentDivisionCicloMateria);
            if (response.IsSuccessStatusCode)
            {
                MostrarAlerta("¡División actualizada correctamente!");
                await LoadDivisionCicloMaterias();
                CloseModal();
            }
            else
            {
                MostrarError("No se pudo actualizar la división. Intenta nuevamente.");
            }
        }
        catch (Exception)
        {
            MostrarError("Error al actualizar la división. Verifica los datos.");
        }
    }


    private async Task DeleteDivisionCicloMateria()
    {
        try
        {
            var response = await Http.DeleteAsync($"api/DivisionCicloMateria/{idDivisionCicloMateriaToDelete}");
            if (response.IsSuccessStatusCode)
            {
                var responseContent = await response.Content.ReadFromJsonAsync<ResponseAPI<int>>();
                if (responseContent != null && responseContent.EsCorrecto)
                {
                    MostrarAlerta("¡División eliminada correctamente!");
                    await LoadDivisionCicloMaterias();
                    CloseConfirmDeleteModal();
                }
                else
                {
                    if (responseContent?.Mensaje.Contains("tiene relaciones asociadas") == true)
                    {
                        MostrarError("Tiene datos Cargados");
                    }
                    else
                    {
                        MostrarError(responseContent?.Mensaje ?? "Error desconocido al eliminar la división.");
                    }
                }
            }
            else
            {
                MostrarError("Error al comunicarse con el servidor. Intente nuevamente.");
            }
        }
        catch (Exception)
        {
            MostrarError("Error al eliminar la división. Intente más tarde.");
        }
    }



    private void MostrarError(string menssage)
    {
        mostraError = true;
        mensage = menssage;

        // Crear un temporizador para ocultar la alerta después de 5 segundos
        var timer = new System.Timers.Timer(5000); // 5000 ms = 5 segundos
        timer.Elapsed += (sender, e) =>
        {
            mostraError = false;
            InvokeAsync(StateHasChanged); // Asegurar que el UI se actualice
            timer.Dispose(); // Liberar el temporizador

        };
        timer.Start();
    }
    private void MostrarAlerta(string menssage)
    {
        mostrarAlerta = true;
        mensage = menssage;
        // Crear un temporizador para ocultar la alerta después de 5 segundos
        var timer = new System.Timers.Timer(5000); // 5000 ms = 5 segundos
        timer.Elapsed += (sender, e) =>
        {
            mostrarAlerta = false;
            InvokeAsync(StateHasChanged); // Asegurar que el UI se actualice
            timer.Dispose(); // Liberar el temporizador

        };
        timer.Start();
    }
  
