@page "/Profesores"
@attribute [Authorize]
@using Microsoft.EntityFrameworkCore

@inject HttpClient Http

@if (showSuccessMessage)
{
    <div class="alert alert-success" role="alert">
        @successMessage
    </div>
}
<PageTitle>Profesor</PageTitle>
<button class="btn btn-success" @onclick="OpenModalToAdd">Cargar Profesor</button>
<button class="btn btn-secondary" @onclick="OpenDeletedModal">Ver Profesores Inactivos</button>
<div class="table-container" style="overflow: hidden; box-shadow: 0 0 10px rgba(0, 0, 0, 0.1); margin-bottom: 20px;">
    <div style="border-top-left-radius: 12px; border-top-right-radius: 12px; background-color: #f2f2f2; padding: 10px;">
        <table class="table" style="border-collapse: collapse; width: 100%; border: 2px solid #E6E6FA;">
            <thead>
                <tr style="border-bottom: 2px solid #ddd;">
                    <th style="border-right: 2px solid #ddd;">Nombre</th>
                    <th style="border-right: 2px solid #ddd;">Apellido</th>
                    <th style="border-right: 2px solid #ddd;">DNI</th>
                    <th style="border-right: 2px solid #ddd;">Estado</th>
                    <th style="border-right: 2px solid #ddd;">Acción</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var profesor in profesores)
                {
                    @if(profesor.Estado== true){
                        <tr>
                            <td style="border-right: 2px solid #ddd;">@profesor.Nombre_Prof</td>
                            <td style="border-right: 2px solid #ddd;">@profesor.Apellido_Prof</td>
                            <td style="border-right: 2px solid #ddd;">@profesor.Dni</td>
                            <td style="border-right: 2px solid #ddd;">@(profesor.Estado ? "Activo" : "Inactivo")</td>
                            <td>
                                <div class="action-buttons m-1">
                                    <button class="btn btn-primary me-2" @onclick="() => OpenModalToEdit(profesor, profesor.IdProfesor)"><i class="oi oi-pencil"></i></button>
                                    <button class="btn btn-danger" @onclick="() => OpenConfirmDeleteModal(profesor.IdProfesor)"><i class="oi oi-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                  
                }
            </tbody>
        </table>
        <!-- Paginación -->
        <nav>
            <ul class="pagination justify-content-center">
                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePage(CurrentPage - 1)">Anterior</button>
                </li>
                @for (int i = 1; i <= TotalPages; i++)
                {
                    <li class="page-item @(CurrentPage == i ? "active" : "")">
                        <button class="page-link" @onclick="() => ChangePage(i)">@i</button>
                    </li>
                }
                <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePage(CurrentPage + 1)">Siguiente</button>
                </li>
            </ul>
        </nav>
    </div>
</div>

@if (isModalOpen)
{
    <div class="modal fade show d-block" style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEdit ? "Editar Profesor" : "Agregar Profesor")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@currentProfesor" OnValidSubmit="@(isEdit ? EditProfesor : AddProfesor)">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" />

                        <div class="mb-3">
                            <label class="form-label">Nombre</label>
                            <InputText class="form-control" @bind-Value="currentProfesor.Nombre_Prof" />
                            <ValidationMessage For="@(() => currentProfesor.Nombre_Prof)" class="text-danger" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Apellido</label>
                            <InputText class="form-control" @bind-Value="currentProfesor.Apellido_Prof" />
                            <ValidationMessage For="@(() => currentProfesor.Apellido_Prof)" class="text-danger" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">DNI</label>
                            <InputNumber class="form-control" @bind-Value="currentProfesor.Dni" />
                            <ValidationMessage For="@(() => currentProfesor.Dni)" class="text-danger" />
                        </div>

                        <button type="submit" class="btn btn-primary">@((isEdit) ? "Guardar Cambios" : "Agregar Profesor")</button>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>

}

@if (isConfirmDeleteModalOpen)
{
    <div class="modal fade show d-block" style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar Eliminación</h5>
                    <button type="button" class="btn-close" @onclick="CloseConfirmDeleteModal"></button>
                </div>
                <div class="modal-body">
                    ¿Estás seguro de que deseas eliminar este Profesor?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseConfirmDeleteModal">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteProfesor">Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}

@if (isDeletedModalOpen)
{
    <div class="custom-modal-overlay">
        <div class="custom-modal-container">
            <div class="custom-modal">
                <div class="custom-modal-header">
                    <h5 class="modal-title">Entidades Eliminadas</h5>
                    <button type="button" class="btn-close" @onclick="CloseDeletedModal"></button>
                </div>
                <div class="custom-modal-body">
                    @if (deletedItems != null && deletedItems.Any(c => !c.Estado))
                    {
                        <table class="custom-table">
                            <thead>
                                <tr>
                                    <th>Nombre</th>
                                    <th>Dni</th>
                                    <th>Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in deletedItems)
                                {
                                    <tr>
                                        <td>@item.Nombre_Prof</td>
                                        <td>@item.Dni</td>
                                        <td>
                                            <button class="custom-btn-activate"
                                                    @onclick="() => ActivateItem(item.IdProfesor)">
                                                Activar
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="custom-alert">
                            No hay entidades eliminadas en este momento.
                        </div>
                    }
                </div>
                <div class="custom-modal-footer">
                    <button class="custom-btn-close" @onclick="CloseDeletedModal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}
@if (mostrarAlerta)
{

    <div class="alert alert-success d-flex align-items-center alert-right animated-alert" role="alert">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-check-circle-fill me-2" viewBox="0 0 16 16">
            <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM6.97 11.03a.75.75 0 0 0 1.08.022L11.97 8a.75.75 0 1 0-1.08-1.04L7.5 10.21 5.646 8.354a.75.75 0 1 0-1.08 1.04l2 2z" />
        </svg>
        <div>
            @mensage
        </div>
    </div>
}
@if (mostraError)
{
    <div class="alert alert-danger d-flex align-items-center alert-right animated-alert" role="alert">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-x-circle-fill me-2" viewBox="0 0 16 16">
            <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
        </svg>
        <div>
            @mensage
        </div>
    </div>

}

@code {
    private int CurrentPage = 1; //pagina actual
    private int PageSize = 10; //cantidad de elementos por pagina
    private int TotalPages;
    private List<Profesor> profesores = new List<Profesor>();
    private DTOProfesor currentProfesor = new DTOProfesor();
    private bool isModalOpen = false;
    private bool isEdit = false;
    private int idProfesorToDelete;
    private bool isConfirmDeleteModalOpen = false;
    int idactual;
    private string successMessage;
    private bool showSuccessMessage = false;
    private bool mostrarAlerta = false;
    private bool mostraError = false;
    string mensage = "";
    protected override async Task OnInitializedAsync()
    {
        await LoadProfesores();
        await LoadDeletedItems();
    }
    private void MostrarError(string menssage)
    {
        mostraError = true;
        mensage = menssage;

        // Crear un temporizador para ocultar la alerta después de 5 segundos
        var timer = new System.Timers.Timer(5000); // 5000 ms = 5 segundos
        timer.Elapsed += (sender, e) =>
        {
            mostraError = false;
            InvokeAsync(StateHasChanged); // Asegurar que el UI se actualice
            timer.Dispose(); // Liberar el temporizador
        };
        timer.Start();
    }
    private void MostrarAlerta(string menssage)
    {
        mostrarAlerta = true;
        mensage = menssage;
        // Crear un temporizador para ocultar la alerta después de 5 segundos
        var timer = new System.Timers.Timer(5000); // 5000 ms = 5 segundos
        timer.Elapsed += (sender, e) =>
        {
            mostrarAlerta = false;
            InvokeAsync(StateHasChanged); // Asegurar que el UI se actualice
            timer.Dispose(); // Liberar el temporizador
        };
        timer.Start();
    }

    private async Task LoadProfesores()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<List<Profesor>>("api/Profesor");

            //actualizacion de paginas
            TotalPages = (int)Math.Ceiling(response.Count / (double)PageSize);

            //obtener los ciclos de la página actual
            profesores = response
                .Skip((CurrentPage - 1) * PageSize)
                .Take(PageSize)
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading profesores: {ex.Message}");
        }
    }

    private async Task ChangePage(int newPage)
    {
        if (newPage < 1 || newPage > TotalPages)
            return;

        CurrentPage = newPage;
        await LoadProfesores();
        StateHasChanged();
    }

    private void OpenModalToAdd()
    {
        currentProfesor = new DTOProfesor();
        isEdit = false;
        isModalOpen = true;
    }

    private void OpenModalToEdit(Profesor profesor, int id)
    {
        currentProfesor = new DTOProfesor
            {
                Nombre_Prof = profesor.Nombre_Prof,
                Apellido_Prof = profesor.Apellido_Prof,
                Dni = profesor.Dni,
                Estado = profesor.Estado
            };
        idactual = id;
        isEdit = true;
        isModalOpen = true;
    }

    private void CloseModal()
    {
        isModalOpen = false;
    }

    private void OpenConfirmDeleteModal(int id)
    {
        idProfesorToDelete = id;
        isConfirmDeleteModalOpen = true;
    }

    private void CloseConfirmDeleteModal()
    {
        isConfirmDeleteModalOpen = false;
    }

    private async Task AddProfesor()
    {
        try
        {
            var response = await Http.PostAsJsonAsync("api/Profesor", currentProfesor);
            if (response.IsSuccessStatusCode)
            {
                MostrarAlerta("Profesor agregado correctamente.");
                await LoadProfesores();
                CloseModal();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                MostrarError($"No se pudo agregar el profesor: {error}");
            }
        }
        catch (Exception ex)
        {
            MostrarError($"Error: {ex.Message}");
        }
    }

    private async Task EditProfesor()
    {
        try
        {
            var response = await Http.PutAsJsonAsync($"api/Profesor/{idactual}", currentProfesor);
            if (response.IsSuccessStatusCode)
            {
                MostrarAlerta("Profesor actualizado correctamente.");
                await OnInitializedAsync();
                CloseModal();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                MostrarError($"No se pudo actualizar el profesor: {error}");
            }
        }
        catch (Exception ex)
        {
            MostrarError($"Error: {ex.Message}");
        }
    }

    private async Task DeleteProfesor()
    {
        try
        {
            var response = await Http.DeleteAsync($"api/Profesor/{idProfesorToDelete}");
            if (response.IsSuccessStatusCode)
            {
                MostrarAlerta("Profesor eliminado correctamente.");
                await OnInitializedAsync();
                CloseConfirmDeleteModal();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                MostrarError($"No se pudo eliminar el profesor: {error}");
            }
        }
        catch (Exception ex)
        {
            MostrarError($"Error: {ex.Message}");
        }
    }
    private bool isDeletedModalOpen = false;
    private List<Profesor> deletedItems = new();

    // Método para abrir el modal
    private async void OpenDeletedModal()
    {
        isDeletedModalOpen = true;
        await OnInitializedAsync();
    }

    // Método para cerrar el modal
    private void CloseDeletedModal()
    {
        isDeletedModalOpen = false;
    }

    // Método para cargar los elementos eliminados desde la API
    private async Task LoadDeletedItems()
    {
        var response = await Http.GetFromJsonAsync<List<Profesor>>("api/Profesor");
        if (response != null)
        {
            deletedItems = response;
        }
    }

    // Método para activar un elemento eliminado
    private async Task ActivateItem(int id)
    {
        try
        {
            var response = await Http.PostAsJsonAsync($"api/Profesor/activar/{id}", id);
            if (response.IsSuccessStatusCode)
            {
                MostrarAlerta("Profesor activado correctamente.");
                await OnInitializedAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                MostrarError($"No se pudo activar el profesor: {error}");
            }
        }
        catch (Exception ex)
        {
            MostrarError($"Error: {ex.Message}");
        }
    }
}



