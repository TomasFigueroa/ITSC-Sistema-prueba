@page "/Division"
@attribute [Authorize]
@using Microsoft.EntityFrameworkCore

@inject HttpClient Http

<PageTitle>Division</PageTitle>
<button class="btn btn-success" @onclick="OpenModalToAdd">Cargar División</button>
<button class="btn btn-secondary" @onclick="OpenModalInactivas">Ver Divisiones Inactivas</button>
<div class="table-container" style="overflow: hidden; box-shadow: 0 0 10px rgba(0, 0, 0, 0.1); margin-bottom: 20px;">
    <div style="border-top-left-radius: 12px; border-top-right-radius: 12px; background-color: #f2f2f2; padding: 10px;">
        <table class="table" style="border-collapse: collapse; width: 100%; border: 2px solid #E6E6FA;">
            <thead>
                <tr style="border-bottom: 2px solid #ddd;">
                    <th style="border-right: 2px solid #ddd;">Nombre</th>
                    <th style="border-right: 2px solid #ddd;">Carrera</th>
                    <th style="border-right: 2px solid #ddd;">Acción</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var division in divisiones)
                {
                    @if(division.Estado==true){
                        <tr>
                            <td style="border-right: 2px solid #ddd;">@division.NombreDiv</td>
                            <td style="border-right: 2px solid #ddd;">@GetNombreCarrera(division.CarrerassIdCarrera)</td> <!-- Obtener el nombre de la carrera -->
                            <td>
                                <div class="action-buttons m-1">
                                    <button class="btn btn-primary me-2" @onclick="() => OpenModalToEdit(division, division.IdDivision)"><i class="oi oi-pencil"></i></button>
                                    <button class="btn btn-danger" @onclick="() => OpenConfirmDeleteModal(division.IdDivision)"><i class="oi oi-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                 
                }
            </tbody>
        </table>
        <nav>
            <ul class="pagination justify-content-center">
                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePage(CurrentPage - 1)">Anterior</button>
                </li>
                @for (int i = 1; i <= TotalPages; i++)
                {
                    <li class="page-item @(CurrentPage == i ? "active" : "")">
                        <button class="page-link" @onclick="() => ChangePage(i)">@i</button>
                    </li>
                }
                <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePage(CurrentPage + 1)">Siguiente</button>
                </li>
            </ul>
        </nav>
    </div>
</div>

<!-- Modal para agregar y editar divisiones -->
@if (isModalOpen)
{
    <div class="modal fade show d-block" style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEdit ? "Editar División" : "Agregar División")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@currentDivision" OnValidSubmit="@(isEdit ? EditDivision : AddDivision)">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label class="form-label">Nombre</label>
                            <InputText class="form-control" @bind-Value="currentDivision.NombreDiv" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Carrera</label>
                            <InputSelect class="form-control" @bind-Value="currentDivision.NombreCar">
                                @foreach (var carrera in carreras)
                                {
                                    <option value="@carrera.IdCarrera">@carrera.Nombre</option>
                                }
                            </InputSelect>
                        </div>
                        <button type="submit" class="btn btn-primary">@((isEdit) ? "Guardar Cambios" : "Agregar División")</button>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal para confirmar eliminación -->
@if (isConfirmDeleteModalOpen)
{
    <div class="modal fade show d-block" style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar Eliminación</h5>
                    <button type="button" class="btn-close" @onclick="CloseConfirmDeleteModal"></button>
                </div>
                <div class="modal-body">
                    ¿Estás seguro de que deseas eliminar esta división?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseConfirmDeleteModal">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteDivision">Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}
@if (mostrarAlerta)
{

    <div class="alert alert-success d-flex align-items-center alert-right animated-alert" role="alert">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-check-circle-fill me-2" viewBox="0 0 16 16">
            <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM6.97 11.03a.75.75 0 0 0 1.08.022L11.97 8a.75.75 0 1 0-1.08-1.04L7.5 10.21 5.646 8.354a.75.75 0 1 0-1.08 1.04l2 2z" />
        </svg>
        <div>
            @mensage
        </div>
    </div>
}
@if (mostraError)
{
    <div class="alert alert-danger d-flex align-items-center alert-right animated-alert" role="alert">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-x-circle-fill me-2" viewBox="0 0 16 16">
            <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
        </svg>
        <div>
            @mensage
        </div>
    </div>

}
@* 
Modal de datos Inactivos *@
@if (isModalInactivasOpen)
{
    <div class="custom-modal-overlay">
        <div class="custom-modal-container">
            <div class="custom-modal">
                <div class="custom-modal-header">
                    <h5 class="modal-title">Divisiones Inactivas</h5>
                    <button type="button" class="btn-close" @onclick="CloseModalInactivas"></button>
                </div>
                <div class="custom-modal-body">
                    @if (divisionesInactivas != null && divisionesInactivas.Any(c => !c.Estado))
                    {
                        <table class="custom-table">
                            <thead>
                                <tr>
                                    <th>Nombre</th>
                                    <th>Carrera</th>
                                    <th>Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var division in divisionesInactivas)
                                {
                                    <tr>
                                        <td>@division.NombreDiv</td>
                                        <td>@GetNombreCarrera(division.CarrerassIdCarrera)</td>
                                        <td>
                                            <button class="btn btn-success" @onclick="() => ActivateDivision(division.IdDivision)">
                                                Activar
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="custom-alert">
                            No hay Divisiones inactivas en este momento.
                        </div>
                    }
                </div>
                <div class="custom-modal-footer">
                    <button class="custom-btn-close" @onclick="CloseModalInactivas">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
   
}

@code {
    private int CurrentPage = 1; //pagina actual
    private int PageSize = 10; //cantidad de elementos por pagina
    private int TotalPages;
    private Divisiones division = new Divisiones();
    private List<Divisiones> divisiones = new List<Divisiones>();
    private List<Carrerass> carreras = new List<Carrerass>();
    private bool isModalOpen = false;
    private bool isEdit = false;
    private DTODivison currentDivision = new DTODivison();
    private int divisionToDeleteId;
    private bool isConfirmDeleteModalOpen = false;
    int idactual;
    public Context context;
    //alerta
    private bool mostrarAlerta = false;
    private bool mostraError = false;
    string mensage = "";
    private void MostrarError(string menssage)
    {
        mostraError = true;
        mensage = mensage;

        // Crear un temporizador para ocultar la alerta después de 5 segundos
        var timer = new System.Timers.Timer(5000); // 5000 ms = 5 segundos
        timer.Elapsed += (sender, e) =>
        {
            mostraError = false;
            InvokeAsync(StateHasChanged); // Asegurar que el UI se actualice
            timer.Dispose(); // Liberar el temporizador
        };
        timer.Start();
    }
    private void MostrarAlerta(string menssage)
    {
        mostrarAlerta = true;
        mensage = menssage;
        // Crear un temporizador para ocultar la alerta después de 5 segundos
        var timer = new System.Timers.Timer(5000); // 5000 ms = 5 segundos
        timer.Elapsed += (sender, e) =>
        {
            mostrarAlerta = false;
            InvokeAsync(StateHasChanged); // Asegurar que el UI se actualice
            timer.Dispose(); // Liberar el temporizador
        };
        timer.Start();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDivisiones();
        await LoadCarreras();
        await LoadDivisionesInactivas();

    }
    private async Task ChangePage(int newPage)
    {
        if (newPage < 1 || newPage > TotalPages)
            return;

        CurrentPage = newPage;
        await LoadDivisiones();
        StateHasChanged();
    }
    private string GetNombreCarrera(int idCarrera)
    {
        var carrera = carreras.FirstOrDefault(c => c.IdCarrera == idCarrera);
        return carrera?.Nombre ?? "Carrera no encontrada";
    }
    private async Task LoadDivisiones()
    {
        try
        {
            divisiones = await Http.GetFromJsonAsync<List<Divisiones>>("api/Division");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading divisiones: {ex.Message}");
        }
        try
        {
            divisionesInactivas = await Http.GetFromJsonAsync<List<Divisiones>>("api/Division");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading divisiones: {ex.Message}");
        }
        idactual = 0;
    }

    private async Task LoadCarreras()
    {
        try
        {
            carreras = await Http.GetFromJsonAsync<List<Carrerass>>("api/Carrera");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading carreras: {ex.Message}");
        }

    }

    private void OpenModalToAdd()
    {
        currentDivision = new DTODivison();
        isEdit = false;
        isModalOpen = true;
    }

    private void OpenModalToEdit(Divisiones division, int id)
    {
        currentDivision = new DTODivison
            {

                NombreDiv = division.NombreDiv,
                NombreCar = division.CarrerassIdCarrera
            };
        idactual = id;
        isEdit = true;
        isModalOpen = true;
    }

    private void CloseModal()
    {
        isModalOpen = false;
    }

    private async Task AddDivision()
    {
        try
        {
            var response = await Http.PostAsJsonAsync("api/Division", currentDivision);
            if (response.IsSuccessStatusCode)
            {
                await LoadDivisiones();
                MostrarAlerta("Division cargada correctamente.");
                CloseModal();
            }
            else
            {
                MostrarError("No se cargó correctamente la Division.");
                Console.WriteLine($"Error adding division: {response.ReasonPhrase}");
            }
        }
        catch (Exception ex)
        {
            MostrarError("Error al tratar de cargar la Division.");
            Console.WriteLine($"Exception adding division: {ex.Message}");
        }
    }

    private async Task EditDivision()
    {
        try
        {
            var response = await Http.PutAsJsonAsync($"api/Division/{idactual}", currentDivision);
            if (response.IsSuccessStatusCode)
            {
                await LoadDivisiones();
                MostrarAlerta("Division editada correctamente.");
                CloseModal();
            }
            else
            {
                MostrarError("No se edito correctamente la Division.");
                Console.WriteLine($"Error editing division: {response.ReasonPhrase}");
            }
        }
        catch (Exception ex)
        {
            MostrarError("Error al tratar de editar la Division.");
            Console.WriteLine($"Exception editing division: {ex.Message}");
        }
    }

    private void OpenConfirmDeleteModal(int id)
    {
        idactual = id;
        isConfirmDeleteModalOpen = true;
    }

    private void CloseConfirmDeleteModal()
    {
        isConfirmDeleteModalOpen = false;
    }

    private async Task DeleteDivision()
    {
        try
        {
            var response = await Http.DeleteAsync($"api/Division/{idactual}");
            if (response.IsSuccessStatusCode)
            {
                await LoadDivisiones();
                MostrarAlerta("Division eliminada correctamente.");
                CloseConfirmDeleteModal();
            }
            else
            {
                MostrarError("No se elimino correctamente la Division.");
                Console.WriteLine($"Error deleting division: {response.ReasonPhrase}");
            }
        }
        catch (Exception ex)
        {
            MostrarError("Error al tratar de eliminar la Division.");
            Console.WriteLine($"Exception deleting division: {ex.Message}");
        }
    }
    private bool isModalInactivasOpen = false;
    private List<Divisiones> divisionesInactivas = new List<Divisiones>();

    // Abrir modal de divisiones inactivas
    private async Task OpenModalInactivas()
    {
        await LoadDivisionesInactivas();
        isModalInactivasOpen = true;
    }

    // Cerrar modal de divisiones inactivas
    private void CloseModalInactivas()
    {
        isModalInactivasOpen = false;
    }

    // Cargar divisiones inactivas desde la API
    private async Task LoadDivisionesInactivas()
    {
        try
        {
            divisionesInactivas = await Http.GetFromJsonAsync<List<Divisiones>>("api/Division/Inactivas");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading inactive divisions: {ex.Message}");
        }
    }

    // Activar una división
    private async Task ActivateDivision(int id)
    {
        try
        {
            var response = await Http.PutAsync($"api/Division/Activate/{id}", null);
            if (response.IsSuccessStatusCode)
            {
                MostrarAlerta("División activada correctamente.");
              
                await OnInitializedAsync();
            }
            else
            {
                MostrarError("Error al activar la división.");
                Console.WriteLine($"Error activating division: {response.ReasonPhrase}");
            }
        }
        catch (Exception ex)
        {
            MostrarError("Error al intentar activar la división.");
            Console.WriteLine($"Exception activating division: {ex.Message}");
        }
    }
}
