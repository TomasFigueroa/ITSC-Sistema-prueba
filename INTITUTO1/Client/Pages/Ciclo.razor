@page "/Ciclo"
@attribute [Authorize]
@using Microsoft.EntityFrameworkCore

@inject HttpClient Http

<PageTitle>Ciclo</PageTitle>
<button class="btn btn-success" @onclick="OpenModalToAdd">Cargar Ciclo</button>

<button class="btn btn-secondary" @onclick="OpenDeletedCiclosModal">Mostrar Eliminados</button>


<div class="table-container" style="overflow: hidden; box-shadow: 0 0 10px rgba(0, 0, 0, 0.1); margin-bottom: 20px;">
    <div style="border-top-left-radius: 12px; border-top-right-radius: 12px; background-color: #f2f2f2; padding: 10px;">
        <table class="table" style="border-collapse: collapse; width: 100%; border: 2px solid #E6E6FA;">
            <thead>
                <tr style="border-bottom: 2px solid #ddd;">
                    <th style="border-right: 2px solid #ddd;">Fecha</th>
                    <th style="border-right: 2px solid #ddd;">Acción</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ciclo in ciclos)
                {
                    @if(ciclo.Estado== true){
                        <tr>
                            <td style="border-right: 2px solid #ddd;">@ciclo.Fecha</td>
                            <td>
                                <div class="action-buttons m-1">
                                    <button class="btn btn-primary me-2" @onclick="() => OpenModalToEdit(ciclo, ciclo.IdCiclo)"><i class="oi oi-pencil"></i></button>
                                    <button class="btn btn-danger" @onclick="() => OpenConfirmDeleteModal(ciclo.IdCiclo)"><i class="oi oi-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                   
                }
            </tbody>
        </table>
        <!-- Paginación -->
        <nav>
            <ul class="pagination justify-content-center">
                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePage(CurrentPage - 1)">Anterior</button>
                </li>
                @for (int i = 1; i <= TotalPages; i++)
                {
                    <li class="page-item @(CurrentPage == i ? "active" : "")">
                        <button class="page-link" @onclick="() => ChangePage(i)">@i</button>
                    </li>
                }
                <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePage(CurrentPage + 1)">Siguiente</button>
                </li>
            </ul>
        </nav>
    </div>
</div>

@if (isModalOpen)
{
    <div class="modal fade show d-block" style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEdit ? "Editar Ciclo" : "Agregar Ciclo")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@currentCiclo" OnValidSubmit="@(isEdit ? EditCiclo : AddCiclo)">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label class="form-label">Fecha</label>
                            <InputText class="form-control" @bind-Value="currentCiclo.Fecha" />
                        </div>
                        <button type="submit" class="btn btn-primary">@((isEdit) ? "Guardar Cambios" : "Agregar Ciclo")</button>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@if (isConfirmDeleteModalOpen)
{
    <div class="modal fade show d-block" style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar Eliminación</h5>
                    <button type="button" class="btn-close" @onclick="CloseConfirmDeleteModal"></button>
                </div>
                <div class="modal-body">
                    ¿Estás seguro de que deseas eliminar este ciclo?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseConfirmDeleteModal">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteCiclo">Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}
@if (isDeletedCiclosModalOpen)
{
    <div class="custom-modal-overlay">
        <div class="custom-modal-container">
            <div class="custom-modal">
                <div class="custom-modal-header">
                    <h5 class="modal-title">Ciclos Eliminados</h5>
                    <button type="button" class="btn-close" @onclick="CloseDeletedCiclosModal"></button>
                </div>
                <div class="custom-modal-body">
                    @if (ciclos != null && ciclos.Any(c => !c.Estado))
                    {
                        <table class="custom-table">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ciclo in ciclos)
                                {
                                    <tr>
                                        <td>@ciclo.Fecha</td>
                                        <td>
                                            <button class="custom-btn-activate"
                                                    @onclick="() => ActivateCiclo(ciclo.IdCiclo)">
                                                Activar
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="custom-alert">
                            No hay ciclos eliminados en este momento.
                        </div>
                    }
                </div>
                <div class="custom-modal-footer">
                    <button class="custom-btn-close" @onclick="CloseDeletedCiclosModal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}


@code {
    private int CurrentPage = 1; //pagina actual
    private int PageSize = 10; //cantidad de elementos por pagina
    private int TotalPages;
    private List<Ciclos> ciclos = new List<Ciclos>();
    private DTOCiclo currentCiclo = new DTOCiclo();
    private bool isModalOpen = false;
    private bool isEdit = false;
    private int idCicloToDelete;
    private bool isConfirmDeleteModalOpen = false;
    int idactual;

    protected override async Task OnInitializedAsync()
    {
        await LoadCiclos();
   
    }

    private async Task LoadCiclos()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<List<Ciclos>>("api/Ciclo");

            //actualizacion de paginas
            TotalPages = (int)Math.Ceiling(response.Count / (double)PageSize);

            //obtener los ciclos de la página actual
            ciclos = response
                .Skip((CurrentPage - 1) * PageSize)
                .Take(PageSize)
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading ciclos: {ex.Message}");
        }
    }

    private async Task ChangePage(int newPage)
    {
        if (newPage < 1 || newPage > TotalPages)
            return;

        CurrentPage = newPage;
        await LoadCiclos();
        StateHasChanged();
    }


    private void OpenModalToAdd()
    {
        currentCiclo = new DTOCiclo();
        isEdit = false;
        isModalOpen = true;
    }

    private void OpenModalToEdit(Ciclos ciclo, int id)
    {
        currentCiclo = new DTOCiclo
            {
                Fecha = ciclo.Fecha
            };
        idactual = id;
        isEdit = true;
        isModalOpen = true;
    }

    private void CloseModal()
    {
        isModalOpen = false;
    }

    private async Task AddCiclo()
    {
        try
        {
            var response = await Http.PostAsJsonAsync("api/Ciclo", currentCiclo);
            if (response.IsSuccessStatusCode)
            {
                await LoadCiclos();
                CloseModal();
            }
            else
            {
                Console.WriteLine($"Error adding ciclo: {response.ReasonPhrase}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception adding ciclo: {ex.Message}");
        }
    }

    private async Task EditCiclo()
    {
        try
        {
            var response = await Http.PutAsJsonAsync($"api/Ciclo/{idactual}", currentCiclo);
            if (response.IsSuccessStatusCode)
            {
                await LoadCiclos();
                CloseModal();
            }
            else
            {
                Console.WriteLine($"Error editing ciclo: {response.ReasonPhrase}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception editing ciclo: {ex.Message}");
        }
    }

    private void OpenConfirmDeleteModal(int id)
    {
        idactual = id;
        isConfirmDeleteModalOpen = true;
    }

    private void CloseConfirmDeleteModal()
    {
        isConfirmDeleteModalOpen = false;
    }

    private async Task DeleteCiclo()
    {
        try
        {
            var response = await Http.DeleteAsync($"api/Ciclo/{idactual}");
            if (response.IsSuccessStatusCode)
            {
                await LoadCiclos();
                CloseConfirmDeleteModal();
            }
            else
            {
                Console.WriteLine($"Error deleting ciclo: {response.ReasonPhrase}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception deleting ciclo: {ex.Message}");
        }
    }
    private bool isDeletedCiclosModalOpen = false; // Estado del modal de eliminados
    private List<Ciclos> deletedCiclos = new List<Ciclos>(); // Lista de ciclos eliminados

    // Abrir el modal de ciclos eliminados
    private async Task OpenDeletedCiclosModal()
    {
        await LoadCiclos();
        isDeletedCiclosModalOpen = true;
    }

    // Cerrar el modal de ciclos eliminados
    private void CloseDeletedCiclosModal()
    {
        isDeletedCiclosModalOpen = false;
    }

    // Cargar los ciclos eliminados
  

    // Activar un ciclo eliminado
    private async Task ActivateCiclo(int id)
    {
        try
        {
            var response = await Http.PutAsync($"api/Ciclo/activar/{id}", null);
            if (response.IsSuccessStatusCode)
            {
                
                await LoadCiclos();
            }
            else
            {
                Console.WriteLine($"Error activating ciclo: {response.ReasonPhrase}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception activating ciclo: {ex.Message}");
        }
    }

}

