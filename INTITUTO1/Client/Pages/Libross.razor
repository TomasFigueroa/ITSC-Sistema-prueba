@page "/Libros"
@attribute [Authorize]

@inject HttpClient Http

<PageTitle>Libros</PageTitle>
<button class="btn btn-success" @onclick="OpenModalToAdd">Cargar Libro</button>
<button class="btn btn-secondary" @onclick="OpenDeletedLibrosModal">Mostrar Eliminados</button>

@if (isSuccessMessageVisible)
{
    <div class="alert alert-success mt-3" role="alert">
        Se ha agregado un libro
    </div>
}

<div class="table-container" style="overflow: hidden; box-shadow: 0 0 10px rgba(0, 0, 0, 0.1); margin-bottom: 20px;">
    <div style="border-top-left-radius: 12px; border-top-right-radius: 12px; background-color: #f2f2f2; padding: 10px;">
        <table class="table" style="border-collapse: collapse; width: 100%; border: 2px solid #E6E6FA;">
            <thead>
                <tr style="border-bottom: 2px solid #ddd;">
                    <th style="border-right: 2px solid #ddd;">Nombre</th>
                    <th style="border-right: 2px solid #ddd;">Acción</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var libro in libros)
                {
                    <tr>
                        <td style="border-right: 2px solid #ddd;">@libro.Nombre_Lib</td>
                        <td>
                            <div class="action-buttons m-1">
                                <button class="btn btn-primary me-2" @onclick="() => OpenModalToEdit(libro, libro.Id_Libro)"><i class="oi oi-pencil"></i></button>
                                <button class="btn btn-danger" @onclick="() => OpenConfirmDeleteModal(libro, libro.Id_Libro)"><i class="oi oi-trash"></i></button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <!-- Paginación -->
        <nav>
            <ul class="pagination justify-content-center">
                <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePage(CurrentPage - 1)">Anterior</button>
                </li>
                @for (int i = 1; i <= TotalPages; i++)
                {
                    <li class="page-item @(CurrentPage == i ? "active" : "")">
                        <button class="page-link" @onclick="() => ChangePage(i)">@i</button>
                    </li>
                }
                <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="() => ChangePage(CurrentPage + 1)">Siguiente</button>
                </li>
            </ul>
        </nav>
    </div>
</div>

<!-- Modal para agregar y editar libros -->
@if (isModalOpen)
{
    <div class="modal fade show d-block" style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEdit ? "Editar Libro" : "Agregar Libro")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@currentLibro" OnValidSubmit="@(isEdit ? EditLibro : AddLibro)">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label class="form-label">Nombre</label>
                            <InputText class="form-control" @bind-Value="currentLibro.Nombre_Lib" />
                        </div>
                        <button type="submit" class="btn btn-primary">@((isEdit) ? "Guardar Cambios" : "Agregar Libro")</button>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

<!-- Modal para confirmar eliminación -->
@if (isConfirmDeleteModalOpen)
{
    <div class="modal fade show d-block" style="background-color: rgba(0, 0, 0, 0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar Eliminación</h5>
                    <button type="button" class="btn-close" @onclick="CloseConfirmDeleteModal"></button>
                </div>
                <div class="modal-body">
                    ¿Estás seguro de que deseas eliminar este libro?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseConfirmDeleteModal">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteLibro">Eliminar</button>
                </div>
            </div>
        </div>
    </div>
}

//libros eliminados
@if (isDeletedLibrosModalOpen)
{
    <div class="custom-modal-overlay">
        <div class="custom-modal-container">
            <div class="custom-modal">
                <div class="custom-modal-header">
                    <h5 class="modal-title">Libros Eliminados</h5>
                    <button type="button" class="btn-close" @onclick="CloseDeletedLibrosModal"></button>
                </div>
                <div class="custom-modal-body">
                    @if (libros != null && libros.Any(c => !c.Estado))
                    {
                        <table class="custom-table">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var libros in libros)
                                {
                                    <tr>
                                        <td>@libros.Nombre_Lib</td>
                                        <td>
                                            <button class="custom-btn-activate"
                                                    @onclick="() => ActivateLibro(libros.Id_Libro)">
                                                Activar
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="custom-alert">
                            No hay ciclos eliminados en este momento.
                        </div>
                    }
                </div>
                <div class="custom-modal-footer">
                    <button class="custom-btn-close" @onclick="CloseDeletedLibrosModal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private int CurrentPage = 1; //pagina actual
    private int PageSize = 10; //cantidad de elementos por pagina
    private int TotalPages;
    int idLibroLocal;
    LIbros Libros = new LIbros();
    List<LIbros> libros = new List<LIbros>();
    private bool isModalOpen = false;
    private bool isEdit = false;
    private DTOLibros currentLibro = new DTOLibros();
    private LIbros libroToDelete;
    private bool isConfirmDeleteModalOpen = false;
    private bool isSuccessMessageVisible = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadLibros();
    }

    private async Task LoadLibros()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<List<LIbros>>("api/Libros");

            //actualizacion de paginas
            TotalPages = (int)Math.Ceiling(response.Count / (double)PageSize);

            //obtener los ciclos de la página actual
            libros = response
                .Skip((CurrentPage - 1) * PageSize)
                .Take(PageSize)
                .ToList();

        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading libros: {ex.Message}");
        }
    }

    private async Task ChangePage(int newPage)
    {
        if (newPage < 1 || newPage > TotalPages)
            return;

        CurrentPage = newPage;
        await LoadLibros();
        StateHasChanged();
    }

    private void OpenModalToAdd()
    {
        currentLibro = new DTOLibros();
        isEdit = false;
        isModalOpen = true;
    }

    private void OpenModalToEdit(LIbros libro, int id)
    {
        currentLibro = new DTOLibros
            {
                Nombre_Lib = libro.Nombre_Lib,
            };
        idLibroLocal = id;
        isEdit = true;
        isModalOpen = true;
    }

    private void CloseModal()
    {
        isModalOpen = false;
    }

    private async Task AddLibro()
    {
        try
        {
            var response = await Http.PostAsJsonAsync("api/Libros", currentLibro);
            if (response.IsSuccessStatusCode)
            {
                await LoadLibros();
                CloseModal();
                ShowSuccessMessage();
            }
            else
            {
                Console.WriteLine($"Error adding libro: {response.ReasonPhrase}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception adding libro: {ex.Message}");
        }
    }

    private async Task EditLibro()
    {
        try
        {
            var response = await Http.PutAsJsonAsync($"api/Libros/{idLibroLocal}", currentLibro);
            if (response.IsSuccessStatusCode)
            {
                await LoadLibros();
                CloseModal();
            }
            else
            {
                Console.WriteLine($"Error editing libro: {response.ReasonPhrase}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception editing libro: {ex.Message}");
        }
    }

    private void OpenConfirmDeleteModal(LIbros libro, int id)
    {
        idLibroLocal = id;
        libroToDelete = libro;
        isConfirmDeleteModalOpen = true;
    }

    private void CloseConfirmDeleteModal()
    {
        isConfirmDeleteModalOpen = false;
    }

    private async Task DeleteLibro()
    {
        try
        {
            var response = await Http.DeleteAsync($"api/Libros/{idLibroLocal}");
            if (response.IsSuccessStatusCode)
            {
                await LoadLibros();
                CloseConfirmDeleteModal();
            }
            else
            {
                Console.WriteLine($"Error deleting libro: {response.ReasonPhrase}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception deleting libro: {ex.Message}");
        }
    }

    private void ShowSuccessMessage()
    {
        isSuccessMessageVisible = true;
        _ = Task.Delay(3000).ContinueWith(_ => isSuccessMessageVisible = false);
    }


    #region libros eliminados

    private bool isDeletedLibrosModalOpen = false;
    private List<LIbros> deletedLibros = new List<LIbros>();

    // Abrir el modal de libros eliminados
    private async Task OpenDeletedLibrosModal()
    {
        await LoadLibros();
        isDeletedLibrosModalOpen = true;
    }

    // Cerrar el modal de libros eliminados
    private void CloseDeletedLibrosModal()
    {
        isDeletedLibrosModalOpen = false;
    }



    // Activar un libros eliminado
    private async Task ActivateLibro(int id)
    {
        try
        {
            var response = await Http.PutAsync($"api/Libros/activar/{id}", null);
            if (response.IsSuccessStatusCode)
            {

                await LoadLibros();
            }
            else
            {
                Console.WriteLine($"Error activating ciclo: {response.ReasonPhrase}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception activating ciclo: {ex.Message}");
        }
    }

    #endregion
}
