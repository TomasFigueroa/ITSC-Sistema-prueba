@page "/formulario-certificado"
@using System.Net.Http.Json
@inject HttpClient Http
@inject IJSRuntime JS

<h3 class="text-center mb-4">Certificado de Examen</h3>

<div class="form-container">
    <div class="form-group">
        <InputText @bind-Value="certificado.NombreAdministrador" Placeholder="Nombre del Administrador" class="form-control mb-3" />
    </div>
    <div class="form-group">
        <InputText @bind-Value="certificado.NombreAlumno" Placeholder="Nombre del Alumno" class="form-control mb-3" />
    </div>
    <div class="form-group">
        <InputNumber @bind-Value="certificado.DniAlumno" Placeholder="DNI del Alumno" class="form-control mb-3" />
    </div>
    <div class="form-group">
        <InputText @bind-Value="certificado.Carrera" Placeholder="Carrera" class="form-control mb-3" />
    </div>
    <div class="form-group">
        <InputText @bind-Value="certificado.Interesado" Placeholder="Interesado" class="form-control mb-3" />
    </div>
    <div class="form-group">
        <InputNumber @bind-Value="certificado.DiaNumero" Placeholder="Día" class="form-control mb-3" Min="1" Max="31" />
    </div>
    <div class="form-group">
        <label for="mes-select">Mes</label>
        <InputSelect @bind-Value="certificado.Mes" id="mes-select" class="form-control mb-3">
            <option value="">Seleccione un mes</option>
            <option value="Enero">Enero</option>
            <option value="Febrero">Febrero</option>
            <option value="Marzo">Marzo</option>
            <option value="Abril">Abril</option>
            <option value="Mayo">Mayo</option>
            <option value="Junio">Junio</option>
            <option value="Julio">Julio</option>
            <option value="Agosto">Agosto</option>
            <option value="Septiembre">Septiembre</option>
            <option value="Octubre">Octubre</option>
            <option value="Noviembre">Noviembre</option>
            <option value="Diciembre">Diciembre</option>
        </InputSelect>
    </div>
    <div class="form-group">
        <InputNumber @bind-Value="certificado.Anio" Placeholder="Año" class="form-control mb-3" />
    </div>
    <button @onclick="ExportarExcel" class="btn btn-primary mt-4 w-100">Exportar a Excel</button>
</div>

@if (ShowSuccessMessage)
{
    <div class="alert alert-success mt-3" role="alert">
        Certificado de examen creado con exito
    </div>
}

<style>
    .form-container {
        max-width: 600px;
        margin: 0 auto;
        padding: 20px;
        background-color: #f8f9fa;
        border-radius: 8px;
        box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);
    }

    .form-control {
        font-size: 1.1em;
    }

    .btn-primary {
        background-color: #4CAF50;
        border-color: #4CAF50;
        font-size: 1.2em;
    }

</style>

@code {
    private CertificadoExamen certificado = new CertificadoExamen();
    private bool ShowSuccessMessage { get; set; } = false;

    private async Task ExportarExcel()
    {
        var response = await Http.PostAsJsonAsync("api/Reporte/Template", certificado);
        if (response.IsSuccessStatusCode)
        {
            var bytes = await response.Content.ReadAsByteArrayAsync();
            await JS.InvokeVoidAsync("downloadFileFromBytes", "Certificado.xlsx", bytes);

            ShowSuccessMessage = true;

            await Task.Delay(3000);
            ShowSuccessMessage = false;
            StateHasChanged();
        }
        else
        {
            Console.WriteLine("No se pudo generar el archivo.");
        }
    }
}
